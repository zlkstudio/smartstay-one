# SmartStay ONE — document root. Everything that isn't a real file goes to index.php.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # AutoSSL / Let's Encrypt validation must reach its files over plain HTTP
  RewriteRule ^\.well-known/ - [L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Dotfiles are never served
  RewriteRule (^|/)\. - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# The service worker must always be revalidated so updates roll out.
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "^(?!sw\.js$).+\.(css|js|woff2)$">
    # Safe to cache long: URLs carry ?v=filemtime (fonts are content-stable)
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
